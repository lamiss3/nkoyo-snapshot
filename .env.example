# Browser-visible Supabase project values
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase values for authenticated admin routes
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Private server logs: run drizzle/migrations/0001_adaptive_assessment_logging.sql first.
# Never prefix the service-role key or logging switch with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
ASSESSMENT_LOGGING_ENABLED=false

# Server-only assessment keys. Never add VITE_ to these.
JEV_API_KEY=
# auto uses OpenRouter when its key is present; otherwise the existing direct Gemini connection.
# Use gemini or openrouter to require a specific connection. All settings are server-only.
AI_PROVIDER=auto
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash-lite
# Optional separate paid Gemini model for email writing through OpenRouter.
EMAIL_OPENROUTER_MODEL=
# Existing direct Google connection (also available for rollback).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Personalized email drafts: apply migration 0002. All values below are server-only.
# Optional different model for email writing (otherwise GEMINI_MODEL).
EMAIL_GEMINI_MODEL=
# Recovery endpoint /api/email-jobs requires a random secret of at least 32 characters.
CRON_SECRET=
# Apply migration 0003 and configure a protected minute worker before enabling.
# Only newly captured requests are automatically enrolled. Fixed/old drafts stay review-only.
EMAIL_AUTOMATION_ENABLED=false
# Kit always keeps content private; automatic requests schedule only consented slots.
KIT_API_KEY=
KIT_SENDER_EMAIL=
KIT_CLASSIC_TEMPLATE_ID=
# Test restricts contacts to this list. Production permits new visitor requests.
KIT_MODE=test
KIT_TEST_EMAILS=
